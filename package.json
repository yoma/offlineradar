{
  "name": "offlineradar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify:rules": "npx tsx scripts/verify-product-rules.ts",
    "screen:pilot": "npx tsx scripts/screen-pilot.ts",
    "verify:screening": "npx tsx scripts/verify-screening.ts",
    "ai:screen:compare": "npx tsx scripts/ai-screen-compare.ts",
    "review:build": "npx tsx scripts/build-review.ts",
    "dev:interne-preview": "OFFLINERADAR_INTERNAL_PREVIEW=1 next dev",
    "verify:interne-preview": "npx tsx scripts/verify-interne-preview.ts",
    "dev:tips-local": "OFFLINERADAR_TIPS_LOCAL_STORE=1 OFFLINERADAR_TIPS_ADMIN=1 OFFLINERADAR_TIPS_ADMIN_DEV_BYPASS=1 next dev",
    "dev:tips-neon": "OFFLINERADAR_TIPS_NEON_STORE=1 OFFLINERADAR_TIPS_ADMIN=1 OFFLINERADAR_TIPS_ADMIN_DEV_BYPASS=1 next dev",
    "dev:tips-oauth": "OFFLINERADAR_TIPS_NEON_STORE=1 next dev",
    "verify:tips": "npx tsx scripts/verify-tips.ts",
    "verify:tip-ai": "npx tsx scripts/verify-tip-ai.ts",
    "db:migrate:tips": "node --env-file=.env.local --import tsx scripts/migrate-tips.ts",
    "verify:tips-neon": "node --env-file=.env.local --import tsx scripts/verify-tips-neon.ts",
    "verify:tips-admin": "npx tsx scripts/verify-tips-admin.ts",
    "db:migrate:events": "node --env-file=.env.local --import tsx scripts/migrate-events.ts",
    "verify:events-catalog": "npx tsx scripts/verify-events-catalog.ts",
    "verify:events-neon": "node --env-file=.env.local --import tsx scripts/verify-events-neon.ts",
    "import:preview-events": "node --env-file=.env.local --import tsx scripts/import-preview-events.ts",
    "import:phase4-expansion": "node --env-file=.env.local --import tsx scripts/import-phase4-expansion.ts",
    "db:migrate:catalog-sources": "node --env-file=.env.local --import tsx scripts/migrate-catalog-sources.ts",
    "import:phase5-expansion": "node --env-file=.env.local --import tsx scripts/import-phase5-expansion.ts",
    "import:phase6-expansion": "node --env-file=.env.local --import tsx scripts/import-phase6-expansion.ts",
    "import:phase9-expansion": "node --env-file=.env.local --import tsx scripts/import-phase9-expansion.ts",
    "seed:phase8-sources": "node --env-file=.env.local --import tsx scripts/seed-phase8-sources.ts",
    "db:migrate:event-reports": "node --env-file=.env.local --import tsx scripts/migrate-event-reports.ts",
    "verify:event-reports": "node --env-file=.env.local --import tsx scripts/verify-event-reports.ts",
    "publish:preview-events": "node --env-file=.env.local --import tsx scripts/publish-approved-preview-events.ts",
    "enrich:published-events": "node --env-file=.env.local --import tsx scripts/enrich-published-events.ts",
    "verify:events-feed": "node --env-file=.env.local --import tsx scripts/verify-events-feed.ts",
    "verify:search-filters": "npx tsx scripts/verify-search-filters.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@neondatabase/serverless": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
